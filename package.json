{
  "name": "wanxiang-v2",
  "private": true,
  "version": "0.1.0",
  "description": "万象 v2 · 世界小说编辑器（全栈 TypeScript + PostgreSQL + NestJS）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run start:dev -w apps/server",
    "build:shared": "npm run build -w packages/shared",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "build": "npm run prisma:generate && npm run build:shared && npm run build -w apps/web && npm run build -w apps/server",
    "start:prod": "node apps/server/dist/main.js",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/server",
    "test": "npm run test -w apps/server"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
