# 后端 AI 密钥（仅存于后端，绝不进入前端 bundle）
# 至少配置其中一项；若全部缺失，后端返回 501，前端自动降级为离线演示稿。

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（兼容 OpenAI 接口，通过 baseURL 区分）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Anthropic Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 指定优先使用的提供方：openai | deepseek | claude
# 不填则自动选择已配置的第一项（优先级 openai > deepseek > claude）
AI_PROVIDER=

# 服务监听端口（前端 Vite 代理 /api -> 此端口）
PORT=8787
