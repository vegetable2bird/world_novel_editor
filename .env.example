# ===== 服务端（apps/server 读取）=====
# 本地用 docker-compose 起 PG 时即为该地址；服务器上改成真实连接串
DATABASE_URL="postgresql://wanxiang:wanxiang@localhost:5432/wanxiang?schema=public"
JWT_SECRET="please-change-this-in-production"
JWT_EXPIRES_IN="7d"
PORT="8787"

# 前端构建时注入（Vite）：API 基址。服务器同源部署时填 /api 即可
VITE_API_BASE="/api"
