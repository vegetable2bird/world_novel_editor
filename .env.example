# ===== 服务端运行时（apps/server 读取；由 CI 生成到服务器 .env）=====
# SQLite（零成本零运维，DB 文件落应用目录外，避免部署被覆盖）
DATABASE_URL="file:/var/lib/wanxiang-v2/wanxiang.db"
JWT_SECRET="<由 CI 用 secrets.JWT_SECRET 注入，生产务必随机长字符串>"
JWT_EXPIRES_IN="7d"
PORT="80"            # 无 nginx，Node 直听 80
NODE_ENV="production"

# ===== 前端构建时注入（Vite，构建期确定，不在运行时读取）=====
# 服务器同源部署时填 /api 即可；若前端与后端不同源再填绝对地址
VITE_API_BASE="/api"
